# Port du serveur Express
PORT=3000

# Informations du Bot
BOT_NAME=KAIDO-MD
OWNER_NAME="Mugiwara no plag"
OWNER_NUMBER=50947440869
PREFIX=.
BOT_FOOTER="> 𝐏𝐎𝐖𝐄𝐑𝐄𝐃 𝐁𝐘 𝐏𝐋4𝐆 x *TECH MONDIAL* 👑"

# Statut automatique
AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=true
AUTO_RECORDING=false

# Authentification Dashboard (obligatoire, mot de passe uniquement)
ADMIN_PASS=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Base de données MongoDB — OBLIGATOIRE
# Toutes les creds et clés Signal WhatsApp sont stockées exclusivement ici.
# Le bot ne crée aucun fichier de session local et refuse l'appairage si MongoDB
# est indisponible. Teste cette configuration avec : npm run mongo:check
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=MUGIWARA_NO_PLAG
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_POOL_SIZE=20

# Import des packs Telegram (.tgs). Crée gratuitement ce token avec @BotFather.
TELEGRAM_BOT_TOKEN=

# Téléchargeurs médias (optionnel : les valeurs ci-dessous sont les valeurs par défaut)
FACEBOOK_DOWNLOADER_API=https://fdown.isuru.eu.org
COBALT_API_URLS=https://rue-cobalt.xenon.zone,https://cobaltapi.cjs.nz
# Nécessaire seulement si vos instances Cobalt privées exigent une clé
COBALT_API_KEY=

# Recherche d’images : Pexels prioritaire si cette clé est fournie;
# Openverse est utilisé automatiquement et sans clé en fallback.
PEXELS_API_KEY=

# Antidelete : conservation en mémoire des métadonnées de messages (24 h par défaut)
ANTIDELETE_STORE_MAX=1500
ANTIDELETE_RETENTION_MS=86400000

# .tourl : limite/timing et compte Catbox facultatif. En cas de HTTP 412,
# le bot bascule automatiquement vers les autres hébergeurs configurés.
TOURL_MAX_BYTES=104857600
TOURL_TIMEOUT_MS=60000
CATBOX_USER_HASH=

# Liens
CHANNEL_LINK=https://whatsapp.com/channel/0029Vb6FwIK89inhtCZOlp12
GROUP_INVITE_LINK=https://chat.whatsapp.com/DLK3kh1Ze2qHUfNKCZ3iXN

# Reconnexion résiliente des sessions (backoff avec jitter)
SESSION_RECONNECT_BASE_MS=5000
SESSION_RECONNECT_MAX_MS=120000
# Nombre maximal de tentatives de reconnexion avant abandon (puis relance manuelle)
SESSION_RECONNECT_MAX_ATTEMPTS=12
# Au-delà de cette durée avec une websocket fermée non signalée, le socket est
# fermé de force pour déclencher une reconnexion propre.
SESSION_STALE_AFTER_MS=600000

# Durée maximale d'un appairage en attente de saisie du code. Le verrou est
# relâché immédiatement en cas d'échec ; ce délai n'est qu'un filet.
PAIRING_LOCK_TTL_MS=180000

# Clés IA (Optionnel)
GEMINI_API_KEY=
