# Port du serveur Express
PORT=3000

# Informations du Bot
BOT_NAME=KAIDO-MD
OWNER_NAME="Mugiwara no plag"
OWNER_NUMBER=50947440869
PREFIX=.
# Facultatif : FFmpeg système compilé avec drawtext/libfreetype pour les statuts audio.
# FFMPEG_PATH=/usr/bin/ffmpeg
BOT_FOOTER="> 𝐏𝐎𝐖𝐄𝐑𝐄𝐃 𝐁𝐘 𝐏𝐋4𝐆 x *TECH MONDIAL* 👑"

# Statut automatique
AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=true
AUTO_RECORDING=false

# Authentification Dashboard (obligatoire, mot de passe uniquement)
ADMIN_PASS=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Base de données MongoDB — OBLIGATOIRE
# Toutes les creds et clés Signal WhatsApp sont stockées exclusivement ici.
# Le bot ne crée aucun fichier de session local et refuse l'appairage si MongoDB
# est indisponible. Teste cette configuration avec : npm run mongo:check
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=MUGIWARA_NO_PLAG
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_POOL_SIZE=20

# Traitement des messages entrants : concurrence par session, FIFO par chat.
# Une commande lente dans un chat ne bloque pas les autres chats de la session.
MESSAGE_PROCESSING_CONCURRENCY=4
# File mémoire maximale en attente par session; le dépassement est signalé dans
# /api/session/health et les erreurs au lieu de laisser la RAM croître sans limite.
MESSAGE_QUEUE_LIMIT=500

# Import des packs Telegram (.tgs). Crée gratuitement ce token avec @BotFather.
TELEGRAM_BOT_TOKEN=

# Téléchargeurs médias (optionnel : les valeurs ci-dessous sont les valeurs par défaut)
FACEBOOK_DOWNLOADER_API=https://fdown.isuru.eu.org
COBALT_API_URLS=https://rue-cobalt.xenon.zone,https://cobaltapi.cjs.nz
# Nécessaire seulement si vos instances Cobalt privées exigent une clé
COBALT_API_KEY=

# Recherche d’images : Pexels prioritaire si cette clé est fournie;
# Openverse est utilisé automatiquement et sans clé en fallback.
PEXELS_API_KEY=

# Antidelete : conservation en mémoire des métadonnées de messages (24 h par défaut)
ANTIDELETE_STORE_MAX=400
ANTIDELETE_RETENTION_MS=86400000

# .tostatus : files globales partagées entre toutes les sessions; médias diffusés
# en flux bornés pour éviter de charger des buffers complets dans la RAM.
TOSTATUS_MEDIA_MAX_CONCURRENT=2
TOSTATUS_MEDIA_MAX_QUEUE=4
# Limite les médias entrants et le chemin audio Buffer; le MP4 généré sur disque est diffusé sans plafond.
TOSTATUS_MAX_MEDIA_BYTES=67108864
TOSTATUS_MAX_AUDIO_BYTES=33554432
TOSTATUS_MAX_AUDIO_SECONDS=180
# FFmpeg audio : une conversion active et deux en attente par défaut.
AUDIO_STATUS_MAX_INPUT_BYTES=33554432
AUDIO_STATUS_MAX_CONCURRENT=1
AUDIO_STATUS_MAX_QUEUE=2
# Fichiers de travail audio sur le disque persistant (défaut: ./tmp/audio-status); supprimés après publication.
AUDIO_STATUS_TEMP_DIR=

# .tourl : limite/timing et compte Catbox facultatif. En cas de HTTP 412,
# le bot bascule automatiquement vers les autres hébergeurs configurés.
TOURL_MAX_BYTES=104857600
TOURL_TIMEOUT_MS=60000
CATBOX_USER_HASH=

# Liens
CHANNEL_LINK=https://whatsapp.com/channel/0029Vb6FwIK89inhtCZOlp12
GROUP_INVITE_LINK=https://chat.whatsapp.com/DLK3kh1Ze2qHUfNKCZ3iXN

# Version/protocole WhatsApp Web
# Par défaut, le bot lit la révision actuelle depuis web.whatsapp.com/sw.js et
# conserve la dernière valeur valide pendant les reconnexions (notamment 515).
WA_VERSION_FETCH_TIMEOUT_MS=12000
WA_VERSION_CACHE_TTL_MS=21600000
# Facultatif seulement si sw.js est bloqué sur l'hébergement. Format exact :
# WA_WEB_VERSION=2.3000.1045716975
WA_WEB_VERSION=

# Keepalive Baileys : envoie une IQ ping-pong sur chaque socket existant.
SESSION_KEEPALIVE_INTERVAL_MS=30000
# Watchdog : vérifie les sockets toutes les 30 s; une session durablement fermée
# est relancée via son ordonnanceur normal (aucun redémarrage périodique à l'heure).
SESSION_STALE_AFTER_MS=90000
# Reconnexion résiliente des sessions (backoff avec jitter)
SESSION_RECONNECT_BASE_MS=5000
SESSION_RECONNECT_MAX_MS=120000
# Nombre maximal de tentatives de reconnexion avant abandon (puis relance manuelle)
SESSION_RECONNECT_MAX_ATTEMPTS=12
# Démarrages indépendants en parallèle au boot/.reconnect (maximum 16).
SESSION_STARTUP_CONCURRENCY=4

# Délai maximal pour terminer le handshake Baileys avant de demander un code.
PAIRING_READY_TIMEOUT_MS=45000
# .code détecte le domaine public fourni par la plateforme ou une IP locale.
# Pour forcer une URL complète (HTTPS/reverse proxy), configure PAIRING_API_URL.
# Sinon, PAIRING_HOST/SITE_IP/SITE_URL peuvent préciser l'hôte; le port local vient de PORT.
PAIRING_API_URL=
PAIRING_HOST=
# La commande .code laisse la route locale terminer l'appairage et sa sauvegarde MongoDB.
PAIRING_CODE_HTTP_TIMEOUT_MS=120000
# Durée maximale d'un appairage en attente de saisie du code. Le verrou est
# relâché immédiatement en cas d'échec ; ce délai n'est qu'un filet.
PAIRING_LOCK_TTL_MS=180000

# Mise à jour GitHub (.update)
# Token finement limité aux dépôts nécessaires (Metadata/Contents en lecture);
# ne le partage jamais dans WhatsApp ou les logs.
BOT_UPDATE_GITHUB_TOKEN=
# Facultatifs : dépôt/branche par défaut. Les sélections .update en MongoDB priment.
BOT_UPDATE_REPO=Plag-509-5/bot
BOT_UPDATE_BRANCH=main
# Auto-update du bot depuis la source/branche .update. Opt-in pour éviter toute
# modification de code inattendue : après activation, vérifie après 60 s puis à l'intervalle.
BOT_AUTO_UPDATE_ENABLED=false
BOT_AUTO_UPDATE_INTERVAL_MS=3600000
# Seulement si le code déployé n'est pas dans le dossier du clone Git : chemin vers la racine contenant .git.
# BOT_REPO_PATH=/home/kaido

# IA Kaido — chatbot OFF par défaut; active-le avec .kaido on.
# Au moins une clé est requise. Le routeur passe au fournisseur suivant si une
# API est indisponible; toute la conversation garde le même historique borné.
# Vérifie les quotas/prix actuels du fournisseur et n’utilise que des modèles
# gratuits si tu veux conserver un coût nul. Jina DeepSearch peut répondre plus
# lentement que les fournisseurs de chat instantané; configure sa clé via JINA_API_KEY.
# Une clé simple ou une liste séparée par virgules; les clés sont essayées en rotation
# et une clé suivante est tentée si l’une est limitée (HTTP 401/403/429).
JINA_API_KEY=
JINA_API_KEYS=
JINA_MODEL=jina-deepsearch-v1
JINA_REQUEST_TIMEOUT_MS=120000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_PROVIDER_ORDER=jina,gemini,groq,openrouter,compatible

# Facultatif : tout endpoint OpenAI-compatible HTTPS (clé et modèle requis).
AI_COMPAT_BASE_URL=
AI_COMPAT_API_KEY=
AI_COMPAT_MODEL=

# Limites mémoire, réseau et concurrence (pas de stockage conversationnel Mongo).
AI_REQUEST_TIMEOUT_MS=8000
AI_MAX_OUTPUT_TOKENS=400
AI_MAX_INPUT_CHARS=2000
AI_MAX_ANSWER_CHARS=3000
AI_MEMORY_TTL_MS=21600000
AI_MEMORY_MAX_CONVERSATIONS=300
AI_MEMORY_MAX_MESSAGES=12
AI_MEMORY_MAX_CHARS=12000
AI_MAX_CONCURRENT=2
AI_MAX_QUEUE=12
AI_MAX_PER_CHAT_QUEUE=2
