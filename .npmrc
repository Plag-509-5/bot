# Wileys (Baileys) déclare jimp ^0.16 en peerOptional alors que le projet
# utilise jimp ^0.22 directement. Sans cette ligne, `npm install` échoue en
# ERESOLVE (y compris sur Render/Koyeb) alors que le conflit est inoffensif :
# jimp n'est qu'un extra optionnel côté Wileys.
legacy-peer-deps=true
audit=false
fund=false
