# Le bot utilise Jimp 0.22 ; xzcbailz déclare Jimp ^1.6 en peer optionnel
# (wileys déclarait ^0.16). Ne pas installer une seconde API Jimp incompatible
# avec les commandes existantes. Le fork utilise sharp 0.34.1 en priorité
# pour les miniatures, dépendance directe du bot.
legacy-peer-deps=true
audit=false
fund=false
